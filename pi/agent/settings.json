{
  "theme": "light",
  "enabledModels": [
    "zenmux/anthropic/claude-opus-5.5",
    "zenmux/openai/gpt-6-astra"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:@plannotator/pi-extension",
    "npm:@narumitw/pi-lsp",
    "npm:@hypabolic/pi-hypa",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-background-tasks@latest",
    "npm:pi-image-paste",
    "npm:pi-subagents",
    "npm:@pi-kaush/pi-tool-call-markers",
    "npm:pi-rewind"
  ],
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "terminal": {
    "images": "kitty",
    "showImages": true
  },
  "lastChangelogVersion": "1.4.0",
  "tuiMode": "regular",
  "hideThinkingBlock": true
}
