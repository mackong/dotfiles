{
  "theme": "light",
  "defaultProvider": "zenmux",
  "defaultModel": "zenmux/anthropic/claude-opus-4.8",
  "enabledModels": [
    "zenmux/anthropic/claude-opus-4.8",
    "zenmux/openai/gpt-6-astra"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:@plannotator/pi-extension",
    "npm:@narumitw/pi-lsp",
    "npm:@hypabolic/pi-hypa",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-background-tasks@latest",
    "npm:pi-image-paste",
    "npm:pi-subagents"
  ],
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "terminal": {
    "images": "kitty",
    "showImages": true
  },
  "lastChangelogVersion": "1.1.0"
}
